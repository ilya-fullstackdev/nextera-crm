generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR
  DIRECTOR
  HR
  HR_OPERATOR
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum LeadStatus {
  NEW
  SEARCHING_DM
  FIRST_CONTACT
  DM_FOUND
  QUALIFICATION
  HANDED_TO_MANAGER
  NEGOTIATION
  PROPOSAL_SENT
  DEAL
  REJECTED
  CALLBACK_LATER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum LeadSource {
  YANDEX_MAPS
  GOOGLE_MAPS
  INSTAGRAM
  TIKTOK
  TELEGRAM
  WEBSITE
  REFERRAL
  MANUAL_SEARCH
  OTHER
}

enum ActivityType {
  CALL
  MESSAGE
  EMAIL
  MEETING
  NOTE
  STATUS_CHANGE
  HANDOVER
  FILE
  REJECTION
}

enum TaskType {
  CALL
  MEETING
  EMAIL
  FOLLOW_UP
  OTHER
}

enum TaskStatus {
  PENDING
  DONE
  CANCELLED
}

enum NeedLevel {
  NONE
  POTENTIAL
  CONFIRMED
}

enum DecisionMakerStatus {
  NOT_FOUND
  FOUND
  PARTICIPATES
  MULTIPLE
}

enum DealTimeline {
  NOW
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  UNDEFINED
}

enum BudgetStatus {
  UNKNOWN
  ESTIMATE
  DEFINED
  NONE
}

enum InterestLevel {
  LOW
  MEDIUM
  HIGH
}

enum PayoutRole {
  LEAD_FINDER
  RECRUITER
}

enum PayoutStatus {
  PENDING
  PAID
}

enum ExpensePeriod {
  MONTHLY
  YEARLY
}

enum ExpenseType {
  HOSTING
  DOMAIN
  SSL
  EMAIL
  SERVICE
  OTHER
}

enum RejectionReason {
  NO_NEED
  HAS_CONTRACTOR
  RECENT_WEBSITE
  RECENT_REDESIGN
  EXPENSIVE
  NO_BUDGET
  NOT_NOW
  CHOSE_OTHER
  CANT_REACH_DM
  OTHER
}

model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  login        String     @unique
  passwordHash String
  role         Role       @default(OPERATOR)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
  deletedAt    DateTime?

  // Кто привёл сотрудника в отдел холодных звонков — ему идёт процент с его сделок.
  hiredById String?
  hiredBy   User?   @relation("UserHiredBy", fields: [hiredById], references: [id])
  hires     User[]  @relation("UserHiredBy")

  leadsOwned     Lead[]         @relation("LeadOwner")
  leadsCreated   Lead[]         @relation("LeadCreator")
  dealsClosed    Deal[]         @relation("DealClosedBy")
  payouts        Payout[]       @relation("PayoutRecipient")
  activities     LeadActivity[]
  tasksAssigned  Task[]         @relation("TaskAssignee")
  tasksCreated   Task[]         @relation("TaskCreator")
  auditLogs      AuditLog[]
  files          LeadFile[]
  handoversFrom  LeadHandover[] @relation("HandoverFrom")
  handoversTo    LeadHandover[] @relation("HandoverTo")

  @@index([status])
  @@index([hiredById])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  niche     String?
  city      String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  leads    Lead[]

  @@index([name])
  @@index([website])
}

model Contact {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  firstName       String
  lastName        String?
  position        String?
  phone           String?
  telegram        String?
  email           String?
  isDecisionMaker Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads             Lead[]  @relation("LeadPrimaryContact")
  decisionMakerLeads Lead[] @relation("LeadDecisionMakers")

  @@index([companyId])
  @@index([phone])
}

model Lead {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  contactId String?
  contact   Contact? @relation("LeadPrimaryContact", fields: [contactId], references: [id])

  status   LeadStatus @default(NEW)
  priority Priority   @default(MEDIUM)
  source   LeadSource @default(OTHER)

  ownerId     String
  owner       User   @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User   @relation("LeadCreator", fields: [createdById], references: [id])

  dmStatus          DecisionMakerStatus @default(NOT_FOUND)
  needLevel         NeedLevel           @default(NONE)
  needDescription   String?
  currentWebsite    String?
  problem           String?
  desiredResult     String?
  timeline          DealTimeline        @default(UNDEFINED)
  budgetStatus      BudgetStatus        @default(UNKNOWN)
  budgetComment     String?
  currentContractor String?
  interestLevel     InterestLevel?

  nextContactAt   DateTime?
  contactAttempts Int       @default(0)

  rejectionReason  RejectionReason?
  rejectionComment String?

  handedToManagerAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal           Deal?
  decisionMakers Contact[]      @relation("LeadDecisionMakers")
  activities     LeadActivity[]
  tasks          Task[]
  files          LeadFile[]
  handovers      LeadHandover[]

  @@index([ownerId])
  @@index([status])
  @@index([companyId])
  @@index([priority])
  @@index([nextContactAt])
}

model LeadActivity {
  id       String       @id @default(cuid())
  leadId   String
  lead     Lead         @relation(fields: [leadId], references: [id])
  userId   String
  user     User         @relation(fields: [userId], references: [id])
  type     ActivityType
  comment  String?
  metadata Json?
  createdAt DateTime    @default(now())

  @@index([leadId])
  @@index([createdAt])
}

model Task {
  id     String   @id @default(cuid())
  leadId String?
  lead   Lead?    @relation(fields: [leadId], references: [id])
  title  String
  type   TaskType @default(OTHER)
  dueAt  DateTime
  comment String?
  status TaskStatus @default(PENDING)

  assigneeId  String
  assignee    User   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId])
  @@index([dueAt])
  @@index([status])
}

model LeadFile {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id])
  fileName     String
  category     String?
  storagePath  String
  size         Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([leadId])
}

model LeadHandover {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  fromUserId String
  fromUser   User   @relation("HandoverFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User   @relation("HandoverTo", fields: [toUserId], references: [id])

  dmInfo        String?
  needSummary   String?
  situation     String?
  problem       String?
  desiredResult String?
  timeline      String?
  budget        String?
  discussed     String?
  objections    String?
  nextStep      String?

  createdAt DateTime @default(now())

  @@index([leadId])
}

/// Закрытая сделка — проект, за который клиент заплатил.
model Deal {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id])

  /// Сумма, которую заплатили за работу, в рублях.
  amount  Int
  comment String?

  closedById String
  closedBy   User   @relation("DealClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payouts  Payout[]
  expenses ProjectExpense[]

  @@index([closedAt])
}

/// Сколько и кому нужно выплатить за конкретный проект.
model Payout {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PayoutRecipient", fields: [userId], references: [id])

  role    PayoutRole
  /// Процент от суммы сделки.
  percent Float
  /// Итоговая сумма к выплате в рублях.
  amount  Int

  status PayoutStatus @default(PENDING)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([userId])
  @@index([status])
}

/// Процент выплаты, закреплённый за должностью. Одинаков для всех сделок.
model PayoutRate {
  id   String @id @default(cuid())
  role Role   @unique

  /// Процент, если сотрудник с этой должностью нашёл лид.
  finderPercent Float @default(0)
  /// Процент, если он привёл в отдел того, кто нашёл лид.
  recruiterPercent Float @default(0)

  updatedAt DateTime @updatedAt
}

/// Регулярный расход по проекту: хостинг, домен, почта и т.д.
model ProjectExpense {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  type ExpenseType @default(OTHER)
  name String
  /// Ссылка на панель хостинга или регистратора — для быстрого перехода.
  url  String?

  /// Оплата в рублях за один период.
  amount   Int
  period   ExpensePeriod @default(MONTHLY)
  renewsAt DateTime?
  comment  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  actorName  String
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
